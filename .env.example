# Ambiente: producao | homologacao
AMBIENTE=homologacao

# Token do bot do Telegram (@BotFather) — um bot por ambiente, nunca compartilhado
TELEGRAM_BOT_TOKEN=

# chat_id/user_id do Telegram autorizados a usar o bot (allowlist), separados por vírgula
TELEGRAM_ALLOWED_CHAT_IDS=

# Chave da API do OpenRouter
OPENROUTER_API_KEY=

# Caminho do arquivo do banco SQLite (cifrado via SQLCipher)
DATABASE_PATH=./data/autofinance.db

# Chave de cifragem do banco (SQLCipher) — nunca reaproveitar entre Produção e Homologação
DATABASE_ENCRYPTION_KEY=

# Nível de log do pino — opcional, default "info" (fatal|error|warn|info|debug|trace)
LOG_LEVEL=

# Integração Google (Gmail leitura de fatura/boleto + Calendar de vencimentos, Fase 7).
# Opcional — sem nada abaixo, a integração fica desligada (nenhum erro, jobs não rodam).
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET vêm do Google Cloud Console (projeto com Gmail
# API + Calendar API ativadas, credencial OAuth 2.0 tipo "Aplicativo para computador") —
# só esses dois já habilitam o comando /registrar_email no bot pra vincular a conta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Preenchido automaticamente ao rodar /registrar_email no bot (ou o script manual
# src/scripts/configurarGoogleOAuth.ts) — sem isso, GOOGLE_CLIENT_ID/SECRET sozinhos
# não ativam os jobs de e-mail/calendário, só o comando de vínculo.
GOOGLE_REFRESH_TOKEN=

# Agenda do Google Calendar onde os eventos de vencimento são criados — opcional,
# default "primary" (agenda principal da conta vinculada)
GOOGLE_CALENDAR_ID=
